# Model backend selection: local or modal.
BACKEND=local

# Browser API selection. VITE_API_URL overrides the backend-specific value.
VITE_BACKEND=local
VITE_API_URL=
VITE_API_local=http://127.0.0.1:3020
VITE_API_modal=https://your-lifelens-api.example.com

# Local OpenAI-compatible model endpoint.
LOCAL_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
LOCAL_LLM_MODEL=Qwen/Qwen3.5-9B
LOCAL_LLM_KEY=

# Modal OpenAI-compatible model endpoint and secret.
MODAL_LLM_URL=https://your-modal-endpoint/v1/chat/completions
MODAL_LLM_MODEL=Qwen/Qwen3.5-9B
MODAL_LLM_KEY=

# Comma-separated browser origins allowed to call the Python API.
FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
